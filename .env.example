DB_DSN=postgres://agent_platform:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/agent_platform?sslmode=disable
TEST_DATABASE_URL=postgres://agent_platform_test:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:5432/agent_platform_test?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional real travel providers; missing providers report unavailable.
# live (default) uses real providers; demo uses clearly labelled train/hotel/weather fixtures.
TRAVEL_QUERY_MODE=live
TRAIN_API_KEY=
AMAP_API_KEY=
# Existing RAG MCP stdio server. Use absolute paths and a collection you own.
RAG_MCP_COMMAND=
RAG_MCP_DIR=
RAG_COLLECTION=
# Optional absolute path to the existing RAG server's configuration (e.g. local BGE).
RAG_SETTINGS_PATH=
RAG_MCP_ARGS=["-m","src.mcp_server.server"]
MAX_ITERATIONS=8
# Original Travel business budgets; platform Run/Tool limits below still apply.
TRAVEL_PLANNING_ROUNDS=8
TRAVEL_TURN_SECONDS=600
TRAVEL_CONTEXT_TOKENS=20000
RUN_SECONDS=120
TOOL_SECONDS=10
HEARTBEAT_SECONDS=5
LEASE_SECONDS=20
PAUSE_SECONDS=15
# Only needed for the optional Docker Compose path. Use a URL-safe random value.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
APP_DATABASE_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_URL_SAFE_PASSWORD
# General Agent public web search (official Eino DuckDuckGo v2; no API key)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROXY_URL=
# Optional HTTP(S) proxy for search only, e.g. http://127.0.0.1:YOUR_PROXY_PORT

